<div class="search-form">
  <%= form_with url: users_path, method: :get, local: true do |f| %>
    <div class="field">
      <%= f.label :gender_identity_id, '希望する相手の性別を選択' %>
      <%= f.select :gender_identity_id, options_from_collection_for_select(GenderIdentity.all, :id, :name, params[:gender_identity_id]), include_blank: true %>
    </div>
    <div class="actions">
      <%= f.submit '検索', class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>

<div class="contents row">
  <% @users.each do |user| %>
    <%= render partial: 'user', locals: {user: user} %>
  <% end %>
</div>